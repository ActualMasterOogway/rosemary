# Settings LLDB needs before it can see anything rosetta3 publishes.
#
#   lldb -S tools/rosetta3.lldbinit -- target/release/rosetta3 run <program>
#
# with ROSETTA3_LLDB=1 in the environment. Or copy the line into ~/.lldbinit.
#
# The GDB JIT interface is how a JIT tells a debugger about code it just
# generated. LLDB implements it, but the plugin's default is "every platform
# except macOS" - on an Apple target it is never even constructed, so no
# breakpoint is set and the registrations go nowhere. Nothing the debuggee does
# can change that; it has to be turned on here.
#
# Only macOS needs this file at all. Elsewhere the plugin is already on, and
# `gdb` - which reads the same interface, and gets the same ELF - needs nothing.
settings set plugin.jit-loader.gdb.enable on

# Translated regions arrive as modules named JIT(0x...). This keeps a backtrace
# through generated code readable rather than a column of raw addresses.
settings set frame-format "frame #${frame.index}: ${frame.pc}{ ${module.file.basename}`${function.name-with-args}}{ at ${line.file.basename}:${line.number}}\n"

# Uncomment to watch registrations as they happen - this is where a symfile
# LLDB refuses to parse shows up, as "failed to load module for JIT entry".
# log enable lldb jit
